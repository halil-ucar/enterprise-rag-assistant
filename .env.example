# ── Copy to .env and fill in. NEVER commit .env. ─────────────────────────────

# --- OpenAI (primary cloud provider) -----------------------------------------
OPENAI_API_KEY=sk-...
# Model tiers. Verify the exact IDs against https://platform.openai.com/docs/models
# (mini = default generator; strong = agentic path only).
OPENAI_MODEL_MINI=gpt-5.6-luna
OPENAI_MODEL_STRONG=gpt-5.6-terra
# Optional OpenAI-compatible endpoint (sovereign EU service, vLLM). Empty = OpenAI.
# OPENAI_BASE_URL=

# --- Azure OpenAI (same adapter, config flag — leave empty to use OpenAI) ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_MINI=
AZURE_OPENAI_DEPLOYMENT_STRONG=

# --- Eval judge (policy-gated per data class; judge must differ from generator)
# Cloud judge for public/internal via Anthropic's OpenAI-compatible endpoint
# (commercial API terms: no training on inputs). Leave empty to judge everything
# with the local judge instead. Confidential is ALWAYS judged locally.
ANTHROPIC_API_KEY=
JUDGE_CLOUD_MODEL=claude-sonnet-5
# Local judge (confidential + offline): non-Qwen family (judge != generator),
# per E7 decision pending its calibration gate. Pull with: ollama pull gemma4:e4b
# (the "e" is part of the tag — E4B = effective parameters; gemma4:4b does not exist)
OLLAMA_JUDGE_MODEL=gemma4:e4b

# --- Ollama (local generation: confidential path + offline demo) -------------
# native on the host; containers reach it via host.docker.internal (compose sets this)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# read timeout (s) for non-streaming calls; a cold qwen3 on CPU needs headroom
OLLAMA_TIMEOUT_S=600
# keep the model resident (e.g. 30m) so it stays warm across a long eval run;
# empty = Ollama default (~5min). Set OLLAMA_KEEP_ALIVE=30m before make eval-core.
OLLAMA_KEEP_ALIVE=

# --- Deployment (A1) ----------------------------------------------------------
# demo = showcase mode (default); production = enforced hardening: the app
# REFUSES to start while any readiness finding is open (fail-closed).
DEPLOYMENT_MODE=demo
# auth backend: static-key (demo default) | oidc (A6 — BFF flow, see below)
AUTH_BACKEND=static-key

# --- Identity (A6): OIDC via BFF; demo default stays static-key --------------
# AUTH_BACKEND=oidc
# OIDC_ISSUER_URL=http://localhost:5556/dex
# OIDC_INTERNAL_ISSUER_URL=http://dex:5556/dex   # container backchannel
# OIDC_CLIENT_ID=rag-assistant
# OIDC_CLIENT_SECRET=nordfels-demo-oidc-secret   # or OIDC_CLIENT_SECRET_FILE=/run/secrets/...
# OIDC_CLAIM_DEPARTMENT=department
# Demo bridge ONLY (dex static users carry no custom claims; forbidden in
# production — readiness R10):
# OIDC_DEMO_DEPARTMENT_MAP={"anna@nordfels.example":"it","ben@nordfels.example":"hr"}
# AUTH_SESSION_TTL_S=28800
# SESSION_COOKIE_SECURE=false      # set true behind TLS
# PUBLIC_BASE_URL=http://localhost:8000
# dex demo logins: anna@nordfels.example / ben@nordfels.example (passwords in
# config/dex.yaml comments — demo credentials, fictional domain)

# --- Audit trail (A4): access metadata, append-only; content can never appear ---
AUDIT_ENABLED=true
# production readiness (R7) additionally requires fail-closed audit writes
# for confidential access:
AUDIT_FAIL_CLOSED=false
# AUDIT_RETENTION_DAYS=90

# --- Observability (A5) ------------------------------------------------------
# LOG_JSON=false

# --- Secrets via files (Docker secrets pattern). NAME_FILE fills NAME only
# when NAME itself is unset; a configured but unreadable file aborts startup.
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# DATABASE_URL_FILE=/run/secrets/database_url

# --- Rate limiting (A3), per identity — defaults are demo-sized, not measured ---
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_QUERY_PER_MIN=30
# RATE_LIMIT_QUERY_BURST=10
# RATE_LIMIT_INGEST_PER_MIN=10
# RATE_LIMIT_INGEST_BURST=5
# MAX_QUESTION_CHARS=2000
# MAX_INGEST_BYTES=1000000

# --- Sovereign endpoint extras (A2): JSON merged into request bodies -----------
# e.g. {"chat_template_kwargs": {"enable_thinking": false}} for vLLM-class servers
# OPENAI_EXTRA_BODY=

# --- Infra --------------------------------------------------------------------
DATABASE_URL=postgresql://rag_app:rag_app_pw@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

# --- Behaviour ----------------------------------------------------------------
# default = cloud generator with fallback chain; offline = everything local
RAG_PROFILE=default
# local = sentence-transformers (needs `.[ml]`); fake = deterministic test double
EMBEDDINGS_BACKEND=local
RERANKER_BACKEND=local
# Pin HF model revisions (commit hash) instead of the moving default branch.
# EMBEDDING_MODEL_REVISION=
# RERANKER_MODEL_REVISION=
# dev = native (MPS) SLO profile; container = relaxed CPU SLO profile
RUN_MODE=dev

# --- Demo users (API key → user/department mapping; demo only, SSO in prod) ---
API_KEY_ANNA=demo-anna-it
API_KEY_BEN=demo-ben-hr

# --- Behaviour knobs (quality-vs-latency dials; defaults in src/rag_assistant/config.py) ---
# Uncomment to override. These are the levers the eval matrix measures.
# RETRIEVE_TOP_K=30           # candidates pulled from hybrid search before rerank
# CONTEXT_TOP_N=5             # passages assembled into the generation context
# CONTEXT_TOKEN_BUDGET=4000   # hard cap on context tokens (precision + prefill latency)
# RRF_K=60                    # reciprocal-rank-fusion constant (industry default)
# MAX_LOOP_ITERATIONS=2       # agentic corrective loop cap (runaway guard)
# LOOP_TOKEN_BUDGET=6000      # agentic loop token cap (runaway guard)
# ANSWER_CACHE_TTL_S=3600     # permission-scoped answer cache TTL
# SESSION_TTL_S=86400         # session memory TTL
# FEEDBACK_RETENTION_DAYS=180 # deletion concept: daily worker cron purges older feedback rows
